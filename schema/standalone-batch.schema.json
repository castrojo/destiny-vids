{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/castrojo/destiny-vids/schema/standalone-batch.schema.json",
  "title": "Standalone video batch manifest",
  "description": "A record in stories/standalone/<batch>.json: one batch of standalone videos built outside the seven-act programme. Each video records its source formats, source-time excisions, overlays, optional full-frame takeover, thumbnail pick and audio probes -- provenance and timecodes, never the footage. The schema is closed (additionalProperties: false at every level) so a hand-edited field fails loudly instead of being silently ignored by tools/standalone.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cta_asset",
    "videos"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "cta_asset": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the approved full-frame CTA picture shared by every takeover in the batch."
    },
    "videos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/video"
      }
    }
  },
  "$defs": {
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "source",
        "title",
        "output",
        "thumbnail_output",
        "thumbnail",
        "audio_probes",
        "overlays"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "thumbnail_output": {
          "type": "string",
          "minLength": 1
        },
        "cuts": {
          "type": "array",
          "description": "Authored excisions in source time. tools/standalone.py maps every source-time mark through these before rendering.",
          "items": {
            "$ref": "#/$defs/cut"
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlay"
          }
        },
        "takeover": {
          "$ref": "#/$defs/takeover"
        },
        "thumbnail": {
          "$ref": "#/$defs/thumbnail"
        },
        "audio_probes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/audioProbe"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "youtube_id",
        "video_format_id",
        "audio_format_id",
        "usage_class",
        "source_rights_note"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "youtube_id": {
          "type": "string",
          "minLength": 1
        },
        "video_format_id": {
          "type": "string",
          "minLength": 1,
          "description": "The yt-dlp video format pinned for reproducibility."
        },
        "audio_format_id": {
          "type": "string",
          "minLength": 1,
          "description": "The yt-dlp audio format pinned for reproducibility. A '-drc' format is forbidden: DRC (dynamic range compression) normalises the loudness the audio-quality tenet says to preserve, so tools/standalone.py rejects it outright."
        },
        "usage_class": {
          "enum": [
            "third_party_copyrighted",
            "cc_by_4_0"
          ],
          "description": "Rights bucket, matching vocab/provenance.yaml. This schema is not in the enum generator's MAP, so the list is schema-local and must be kept in step by hand."
        },
        "source_rights_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_sec",
        "end_sec"
      ],
      "properties": {
        "start_sec": {
          "type": "number",
          "minimum": 0
        },
        "end_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "takeover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_at"
      ],
      "properties": {
        "source_at": {
          "type": "number",
          "minimum": 0,
          "description": "Source time at which the CTA picture replaces the video through EOF, preserving source audio unchanged."
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_at"
      ],
      "properties": {
        "source_at": {
          "type": "number",
          "minimum": 0,
          "description": "Source time the thumbnail frame is extracted from."
        }
      }
    },
    "audioProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_at",
        "duration"
      ],
      "properties": {
        "source_at": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source_at",
        "dur"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "An existing plate kind rendered by tools/plate.py; nothing new is invented for this batch."
        },
        "source_at": {
          "type": "number",
          "minimum": 0,
          "description": "Source time the plate appears; mapped through the video's cuts before rendering."
        },
        "dur": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "position": {
          "type": "string"
        },
        "copy_source": {
          "type": "string",
          "description": "Where the on-screen words came from -- the record that they are reproduced, never invented."
        },
        "why": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "speaker": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        }
      }
    }
  }
}
